# App
NODE_ENV=development
PORT=3000

# PostgreSQL (matchea con docker-compose.yml)
POSTGRES_USER=banco
POSTGRES_PASSWORD=banco123
POSTGRES_DB=banco
POSTGRES_PORT=5432
DATABASE_URL=postgresql://banco:banco123@localhost:5432/banco

# Redis (BullMQ - notificaciones)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (Fase 1)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Reglas de negocio (Fases 3 y 4)
DAILY_LIMIT_STANDARD_ARS=500000
DAILY_LIMIT_PREMIUM_ARS=5000000
TRANSFER_FEE_STANDARD_ARS=500
REVERSAL_WINDOW_HOURS=24
FRAUD_MAX_TRANSFERS_PER_WINDOW=5
FRAUD_WINDOW_MINUTES=10
FX_RATE_ARS_USD=1000
